# 环境变量模板：复制为 .env.local 后按需修改（.env.local 不会提交）
# 注意：只有 VITE_ 前缀的变量才会暴露到前端代码，通过 import.meta.env 读取。
# 切勿在这里放密钥等敏感信息，前端变量都会被打包进产物、对用户可见。

# API 基础地址（axios baseURL），见 src/api/request.ts
VITE_API_BASE_URL=/api

# 应用标题（示例）
VITE_APP_TITLE=TeleCraft

# Telegram Login 的 Bot Client ID（数字）。在 @BotFather → 选择 Bot → Login Widget 获取。
# 只填 Client ID，不要填 Client Secret。并把当前页面地址登记为 Allowed URL，
# 本地开发一般是 http://localhost:5173/login（SDK 用 origin + pathname 作为 redirect_uri）。
VITE_TELEGRAM_CLIENT_ID=
